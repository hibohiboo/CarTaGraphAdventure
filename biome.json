{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!docs/.vitepress/cache",
      "!docs/.vitepress/dist",
      "!pnpm-lock.yaml",
      "!.claude/skills/react-best-practices"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noNestedComponentDefinitions": "error",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noSkippedTests": "error",
        "noFocusedTests": "error",
        "noImportCycles": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 200
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 1000
          }
        }
      }
    },
    "domains": {
      "test": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "apps/web/src/test/**", "apps/web/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mjs",
        "apps/web/src/test/**",
        "apps/web/e2e/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTestIt": "error"
          },
          "suspicious": {
            "useExpect": "error",
            "noConditionalExpect": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/web/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTestIt": {
              "level": "error",
              "options": {
                "function": "test",
                "withinDescribe": "test"
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "error",
            "noReExportAll": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "./../**", "@cartagraph/domain", "@cartagraph/domain/**"],
                    "message": "scenario と表に無いディレクトリはほかのディレクトリを import しない（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "error",
            "noReExportAll": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/mocks",
                      "@/mocks/**",
                      "@/test",
                      "@/test/**",
                      "../**",
                      "./../**",
                      ".././**",
                      "src",
                      "src/**",
                      "../..",
                      "./../..",
                      "@/*/../**",
                      "@/./**",
                      "@//**"
                    ],
                    "message": "app は層の外（mocks・test）を import しない。ほかの層は @/<層>/… で import する（docs/process/rules/architecture.md「依存の向き」）"
                  },
                  {
                    "group": ["@cartagraph/schemas", "@cartagraph/schemas/**"],
                    "message": "API のスキーマ（@cartagraph/schemas。本文と応答の型）を import してよいのは entities と mocks・test だけ（docs/process/rules/architecture.md「依存の向き」）"
