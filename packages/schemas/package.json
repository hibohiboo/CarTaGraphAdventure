{
  "name": "@cartagraph/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.test": null,
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=html --reporter=json --outputFile.json=vitest-results/results.json"
  },
  "devDependencies": {
    "@vitest/ui": "^5.0.5",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@cartagraph/domain": "workspace:*",
    "zod": "^4.6.7"
  }
}
